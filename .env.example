# Hermes v2 Environment Configuration

# Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://user:password@host:port/database

# LLM
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Email
SENDGRID_API_KEY=SG.your-sendgrid-api-key
INTAKE_EMAIL_ADDRESS=intake@yourdomain.com
FROM_EMAIL=support@yourdomain.com
FROM_NAME=Support Team

# WhatsApp
TWILIO_ACCOUNT_SID=ACyour-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# WhatsApp Quota Management
# Daily message limit (30 for trial, adjust for paid accounts)
TWILIO_DAILY_MESSAGE_LIMIT=30

# Enable quota tracking to prevent exceeding Twilio limits
WHATSAPP_ENABLE_QUOTA_TRACKING=true

# Send confirmation messages after reviewer actions
# Set to false to save quota (confirmations won't be sent)
WHATSAPP_SEND_CONFIRMATIONS=true

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
